<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.trade.mapper.OrderItemMapper">
    <resultMap id="itemMap" type="com.campus.trade.entity.OrderItemDO">
        <id property="id" column="id"/>
        <result property="orderId" column="order_id"/>
        <result property="productId" column="product_id"/>
        <result property="productTitle" column="product_title"/>
        <result property="productImage" column="product_image"/>
        <result property="price" column="price"/>
        <result property="quantity" column="quantity"/>
        <result property="gmtCreate" column="gmt_create"/>
    </resultMap>

    <insert id="insertBatch">
        INSERT INTO order_item (order_id, product_id, product_title, product_image, price, quantity)
        VALUES
        <foreach collection="items" item="item" separator=",">
            (#{item.orderId}, #{item.productId}, #{item.productTitle}, #{item.productImage}, #{item.price}, #{item.quantity})
        </foreach>
    </insert>

    <select id="selectByOrderId" resultMap="itemMap">
        SELECT id, order_id, product_id, product_title, product_image, price, quantity, gmt_create
        FROM order_item WHERE order_id = #{orderId}
    </select>
</mapper>
