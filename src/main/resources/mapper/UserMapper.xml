<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.trade.mapper.UserMapper">

    <resultMap id="userResultMap" type="com.campus.trade.entity.UserDO">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="nickname" column="nickname"/>
        <result property="avatar" column="avatar"/>
        <result property="phone" column="phone"/>
        <result property="email" column="email"/>
        <result property="school" column="school"/>
        <result property="role" column="role"/>
        <result property="status" column="status"/>
        <result property="gmtCreate" column="gmt_create"/>
        <result property="gmtModified" column="gmt_modified"/>
    </resultMap>

    <select id="selectById" resultMap="userResultMap">
        SELECT id, username, password, nickname, avatar, phone, email, school, role, status, gmt_create, gmt_modified
        FROM user
        WHERE id = #{id}
    </select>

    <select id="selectByUsername" resultMap="userResultMap">
        SELECT id, username, password, nickname, avatar, phone, email, school, role, status, gmt_create, gmt_modified
        FROM user
        WHERE username = #{username}
    </select>

    <insert id="insert" parameterType="com.campus.trade.entity.UserDO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (username, password, nickname, phone, school)
        VALUES (#{username}, #{password}, #{nickname}, #{phone}, #{school})
    </insert>

</mapper>
